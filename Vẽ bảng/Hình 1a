import matplotlib.pyplot as plt
import pandas as pd

df = pd.read_csv("dataset_labeled.csv")

# Tính tỷ lệ % đóng góp của từng kịch bản (network_type) vào mỗi nhãn (label)
# normalize='columns' nghĩa là tổng mỗi cột nhãn (GOOD, ACCEPTABLE, POOR) bằng 100%
ct_composition = (
    pd.crosstab(df["network_type"], df["label"], normalize="columns") * 100
)

# Thứ tự các nhãn hiển thị theo chuẩn
ct_composition = ct_composition[["GOOD", "ACCEPTABLE", "POOR"]]

# Vẽ biểu đồ cột chồng
ax = ct_composition.T.plot(
    kind="bar",
    stacked=True,
    figsize=(9, 6),
    colormap="tab10",
    edgecolor="black",
    linewidth=0.8,
)

plt.title(
    "Cơ cấu tỷ lệ (%) các kịch bản đo kiểm trong từng nhãn chất lượng",
    fontsize=12,
    fontweight="bold",
    pad=15,
)
plt.ylabel("Tỷ trọng đóng góp (%)", fontsize=11, fontweight="bold")
plt.xlabel("Nhãn chất lượng mạng (Label)", fontsize=11, fontweight="bold")
plt.xticks(rotation=0, fontsize=11, fontweight="bold")
plt.ylim(0, 100)
plt.grid(axis="y", linestyle="--", alpha=0.5)

# Đặt chú thích (Legend) ra ngoài để không che biểu đồ
plt.legend(
    title="Kịch bản đo kiểm",
    bbox_to_anchor=(1.02, 1),
    loc="upper left",
    frameon=True,
)

plt.tight_layout()
plt.savefig("fig_label_composition.png", dpi=300)
print("-> Đã xuất thành công biểu đồ: fig_label_composition.png")
